{
  "name": "archai-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c green,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
    "dev:frontend": "npm run dev --prefix frontend -- --host 127.0.0.1 --port 5173",
    "serve:frontend": "python scripts/serve_frontend.py",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && python -m pytest",
    "test:frontend": "npm run test --prefix frontend -- --run",
    "smoke": "node scripts/smoke-test.mjs",
    "lint": "npm run lint --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
